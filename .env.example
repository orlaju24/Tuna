# ════════════════════════════════════════════════════════════════════════════
#  Bitunix Futures Control — environment variables template
#
#  Copy this file to .env and fill in your real values.
#  .env is in .dockerignore and must NEVER be committed to git.
# ════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST_PORT=3000

# ── Database ──────────────────────────────────────────────────────────────
# Local docker-compose: uses the bundled postgres service (hostname = postgres).
# Coolify with managed DB: postgresql://user:pass@your-hetzner-host:5432/dbname
DATABASE_URL=postgresql://bitunix:changeme@postgres:5432/bitunix

# ── API authentication ────────────────────────────────────────────────────
# Every browser request sends this as the x-key header.
# Use a long random string: openssl rand -hex 32
APP_PASSWORD=change-me-before-deploy

# ── Bitunix exchange credentials ──────────────────────────────────────────
BITUNIX_API_KEY=your-bitunix-api-key
BITUNIX_API_SECRET=your-bitunix-api-secret

# ── Webhook trigger (optional) ────────────────────────────────────────────
# Token required by POST /api/trigger/close. Leave blank to disable.
INTERNAL_TRIGGER_TOKEN=your-webhook-token

# ── Behaviour ─────────────────────────────────────────────────────────────
KILL_COOLDOWN=3
DEFAULT_SYMBOL=BTCUSDT

# ── PostgreSQL (docker-compose local only) ────────────────────────────────
POSTGRES_USER=bitunix
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bitunix
